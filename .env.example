# Copy to .env.local for local dev. In Vercel these come from the Neon and
# Blob integrations, plus the two you set by hand.

# Neon Postgres (the Vercel <> Neon integration sets this). For local dev,
# point it at a Neon *branch*, not production.
DATABASE_URL=

# Vercel Blob read/write token (set by the Blob integration).
BLOB_READ_WRITE_TOKEN=

# Any long random string: `openssl rand -hex 32`. Set by hand.
PAYLOAD_SECRET=

# Public site URL. http://localhost:3000 locally, https://www.zmarino.com in prod.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Only for scripts/migrate-from-sanity.ts, and only if the dataset is private.
# SANITY_TOKEN=
